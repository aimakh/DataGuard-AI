# DataGuard AI — Environment Configuration Template
# Open Agent Hackathon 2026
# Copy this file to .env and fill in your credentials. Never commit .env to version control!

# --- Zetaris Platform ---
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_API_URL=http://localhost:8888
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=your_zetaris_password_here

# --- Meterless Nightshift / Local AI Engine ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=meterless_local_key

# --- NVIDIA Nemotron ---
NVIDIA_API_KEY=nvapi-your_nvidia_build_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- Application Configuration ---
APP_HOST=0.0.0.0
APP_PORT=8501
LOG_LEVEL=INFO
